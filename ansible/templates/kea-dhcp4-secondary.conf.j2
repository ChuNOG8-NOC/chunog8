{
  "Dhcp4": {
    "interfaces-config": { "interfaces": ["eth0"] },
    "lease-database": { "type": "memfile" },
    "valid-lifetime": 43200,
    "subnet4": [
      {
        "id": 1,
        "subnet": "202.222.168.0/22",
        "pools": [ { "pool": "202.222.168.100 - 202.222.171.255" } ],
        "option-data": [
          { "name": "routers", "data": "202.222.168.1" },
          { "name": "domain-name-servers", "data": "10.8.30.60" }
        ]
      }
    ],
    "hooks-libraries": [
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_ha.so",
        "parameters": {
          "high-availability": [
            {
              "this-server-name": "secondary",
              "mode": "hot-standby",
              "multi-threading": {
                "enable-multi-threading": true,
                "http-dedicated-listener": true,
                "http-listener-threads": 0,
                "http-client-threads": 0
              },
              "peers": [
                { "name": "primary",   "url": "http://10.8.30.77:8000/", "role": "primary",   "auto-failover": true },
                { "name": "secondary", "url": "http://10.8.30.60:8000/", "role": "standby",   "auto-failover": true }
              ]
            }
          ]
        }
      }
    ]
  }
}
